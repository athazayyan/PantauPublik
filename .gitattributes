# Set default behavior, in case core.autocrlf is not set.
* text=auto

# Declare files that will always have LF line endings in the repo.
*.php text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.blade.php text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.sh text eol=lf
.env.* text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
composer.json text eol=lf
composer.lock text eol=lf
package.json text eol=lf
package-lock.json text eol=lf

# Declare files that will always have CRLF line endings in the repo.
# *.bat text eol=crlf
# *.cmd text eol=crlf

# Denote all files that are truly binary and should not be modified.
# *.png binary
# *.jpg binary